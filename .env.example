# Wimp-Drop environment template
# Copy to .env.local for local development.
# Never commit .env.local or place secret-only values in VITE_* variables.

# ============================================================
# FRONTEND VALUES: safe for the browser, used in .env.local
# ============================================================

# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Flutterwave Dashboard > Settings > API Keys
# Use the test public key during testing and the live public key only in production.
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_your_public_key

# Application configuration
VITE_APP_NAME=Wimp-Drop
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development
VITE_DEBUG_MODE=false
VITE_LOG_API_CALLS=false

# Store configuration
VITE_DEFAULT_CURRENCY=NGN
VITE_TAX_RATE=0.075
VITE_SHIPPING_STANDARD_COST=5000
VITE_SHIPPING_EXPRESS_COST=10000

# Optional local-only development override. Keep disabled and empty by default.
VITE_ENABLE_LOCAL_ADMIN_OVERRIDE=false
VITE_LOCAL_ADMIN_EMAIL=
VITE_LOCAL_ADMIN_PASSWORD=



# Node server
PORT=8080
APP_ORIGIN=http://localhost:8080
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_CREATION_SECRET=generate-a-long-random-admin-secret
RESEND_API_KEY=re_your_resend_api_key

# Flutterwave Supabase Edge Function secrets
# Flutterwave Dashboard > Settings > Webhooks/API
FLW_SECRET_KEY=FLWSECK_TEST_your_secret_key
FLW_WEBHOOK_SECRET_HASH=generate-or-copy-your-webhook-secret-hash

# CJ Dropshipping Supabase Edge Function secret
# CJ Dashboard > My CJ > Authorization > API > Add API
# This is the only CJ secret needed. Never use it in VITE_* client variables.
CJ_API_KEY=CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# Internal scheduled-function authentication
CRON_SECRET=generate-a-long-random-cron-secret

# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to Edge Functions
# when deployed. Set them only for local function emulation if required.
# SUPABASE_URL=https://your-project.supabase.co

# The following are intentionally not used by the current client integration:
# VITE_FLUTTERWAVE_SECRET_KEY=DO_NOT_ADD
